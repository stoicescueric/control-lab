{
  "name": "control-lab",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive curriculum for control theory, state estimation, and FTC robotics, built with Docusaurus.",
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "check:architecture": "node scripts/architecture-check.mjs",
