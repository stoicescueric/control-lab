{
  "name": "control-lab",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive curriculum for control theory, state estimation, and FTC robotics, built with Docusaurus.",
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "check:architecture": "node scripts/architecture-check.mjs",
    "check:content": "node scripts/content-check.mjs",
    "check:contributor": "node scripts/contributor-check.mjs",
    "size": "node scripts/bundle-size.mjs",
    "security": "node scripts/security-check.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:lesson": "node scripts/scaffold-lesson.mjs",
    "verify": "npm run check:architecture && npm run check:content && npm run check:contributor && npm run typecheck && npm test && npm run build && npm run security && npm run size"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-pwa": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "katex": "^0.16.11",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "body-parser@1.20.5": "1.20.6",
    "brace-expansion@1.1.15": "1.1.16",
    "brace-expansion@2.1.1": "2.1.2",
    "brace-expansion@5.0.6": "5.0.8",
    "fast-uri@3.1.2": "3.1.4",
    "http-proxy-middleware@2.0.9": "2.0.10",
    "js-yaml@3.14.2": "3.15.0",
    "js-yaml@4.2.0": "4.3.0",
    "postcss@8.5.15": "8.5.23",
    "serialize-javascript@6.0.2": "7.0.7",
    "shell-quote@1.8.4": "1.10.0",
    "uuid@8.3.2": "11.1.1",
    "webpack-dev-server@5.2.5": "5.2.6"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
