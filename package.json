    "check:contributor": "node scripts/contributor-check.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/bundle-size.mjs",
    "security": "node scripts/security-check.mjs",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "new:lesson": "node scripts/scaffold-lesson.mjs",
